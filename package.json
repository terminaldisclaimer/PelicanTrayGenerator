{
  "name": "pelican-tray-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web app that designs 3D-printable stackable trays to fill Pelican case cutouts.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "test": "vitest run"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "manifold-3d": "^3.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
